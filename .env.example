# HireFlow ATS - Supabase PostgreSQL Configuration
# Copy this file to .env or .env.local and populate with your project credentials.
# Get these values from your Supabase Project Dashboard -> Project Settings -> API.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon API Key (Safe for browser client use)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Optional alias for publishable key (both are supported by HireFlow)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
